---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TAINA — Envíos Marítimos a Isla de Pascua',
  description = 'Transporte marítimo de carga desde Valparaíso, San Antonio y Arica hacia Hanga Roa, Isla de Pascua. Pallets, contenedores FCL, carga LCL y vehículos. Salida semanal.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Cargo marítimo Chile continental → Rapa Nui. Flota propia, frecuencia semanal, logística integral." />
    <meta property="og:image" content="https://picsum.photos/id/1057/1200/630.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%23050505'/%3E%3Ctext x='50' y='68' font-size='60' text-anchor='middle' fill='%2322d3ee' font-family='sans-serif'%3E%E2%9A%93%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://picsum.photos" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased overflow-x-hidden">
    <slot />
  </body>
</html>

---
import Icon from '../ui/Icon.astro';
---

<footer class="relative border-t border-white/5 py-16">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div>
        <a href="#" class="flex items-center gap-2.5 mb-4 group">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center text-cyan-400 transition-transform duration-700 group-hover:rotate-90" style="background:rgba(34,211,238,0.08)">
            <Icon name="anchor" width={22} height={22} />
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-bold text-white text-base tracking-tight">TAINA</span>
            <span class="text-[9px] font-medium text-slate-500 uppercase tracking-widest">Logística Marítima</span>
          </div>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">Líder en transporte marítimo Chile continental → Isla de Pascua.</p>
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10" aria-label="LinkedIn">
            <Icon name="linkedin" width={16} height={16} class="text-slate-400" />
          </span>
          <span class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10" aria-label="Instagram">
            <Icon name="instagram" width={16} height={16} class="text-slate-400" />
          </span>
          <span class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10" aria-label="Facebook">
            <Icon name="facebook" width={16} height={16} class="text-slate-400" />
          </span>
        </div>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Rutas</h4>
        <ul class="space-y-2.5">
          <li><a href="#rutas" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Valparaíso → Rapa Nui</a></li>
          <li><a href="#rutas" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">San Antonio → Rapa Nui</a></li>
          <li><a href="#rutas" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Arica → Rapa Nui</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Servicios</h4>
        <ul class="space-y-2.5">
          <li><a href="#servicios" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Carga palletizada</a></li>
          <li><a href="#servicios" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Contenedores FCL</a></li>
          <li><a href="#servicios" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Carga LCL</a></li>
          <li><a href="#servicios" class="text-sm text-slate-500 hover:text-cyan-400 transition-colors">Almacenaje Hanga Roa</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Contacto</h4>
        <ul class="space-y-2.5">
          <li class="text-sm text-slate-500 flex items-center gap-2">
            <Icon name="phone" width={14} height={14} class="text-slate-600" /> +56 32 210 8800
          </li>
          <li class="text-sm text-slate-500 flex items-center gap-2">
            <Icon name="mail" width={14} height={14} class="text-slate-600" /> cargo@taina.cl
          </li>
          <li class="text-sm text-slate-500 flex items-start gap-2">
            <Icon name="map-pin" width={14} height={14} class="text-slate-600 mt-0.5" /> Terminal 2, Puerto Valparaíso
          </li>
          <li class="text-sm text-slate-500 flex items-start gap-2">
            <Icon name="map-pin" width={14} height={14} class="text-slate-600 mt-0.5" /> Atamu Tekena s/n, Hanga Roa
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-600">© 2025 TAINA Chile SpA. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <span class="text-xs text-slate-600">Términos</span>
        <span class="text-xs text-slate-600">Privacidad</span>
        <span class="text-xs text-slate-600">Seguros</span>
      </div>
    </div>
  </div>
</footer>

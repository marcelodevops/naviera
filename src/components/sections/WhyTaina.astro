---
import Icon from '../ui/Icon.astro';
---

<section class="relative py-20 border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="reveal text-center group">
        <div class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
          <Icon name="anchor" width={24} height={24} class="text-cyan-400" />
        </div>
        <h4 class="text-sm font-bold text-white mb-1">Flota Propia</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Sin intermediarios. Control total.</p>
      </div>
      <div class="reveal text-center group">
        <div class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
          <Icon name="map" width={24} height={24} class="text-cyan-400" />
        </div>
        <h4 class="text-sm font-bold text-white mb-1">Ruta Exclusiva</h4>
        <p class="text-xs text-slate-500 leading-relaxed">15 años en Chile–Rapa Nui.</p>
      </div>
      <div class="reveal text-center group">
        <div class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center border border-white/10 group-hover:border-teal-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
          <Icon name="warehouse" width={24} height={24} class="text-teal-400" />
        </div>
        <h4 class="text-sm font-bold text-white mb-1">Bodega en Isla</h4>
        <p class="text-xs text-slate-500 leading-relaxed">800m² en Hanga Roa.</p>
      </div>
      <div class="reveal text-center group">
        <div class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center border border-white/10 group-hover:border-cyan-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
          <Icon name="shield-check" width={24} height={24} class="text-cyan-400" />
        </div>
        <h4 class="text-sm font-bold text-white mb-1">Seguro Integrado</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Cobertura total puerta a puerta.</p>
      </div>
    </div>
  </div>
</section>

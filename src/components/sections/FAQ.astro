---
import Icon from '../ui/Icon.astro';

const faqs = [
  {
    q: '¿Cuánto tarda el envío desde Valparaíso hasta Rapa Nui?',
    a: '4 a 5 días navegando, más 1-2 días de operaciones portuarias. Total estimado: 6 a 8 días door-to-door. Usá nuestro estimador de tiempos.',
  },
  {
    q: '¿Cómo obtengo el precio de un envío?',
    a: 'Los precios se envían exclusivamente por correo electrónico. Completá el formulario y recibís una propuesta en menos de 2 horas hábiles.',
  },
  {
    q: '¿Cómo rastreo mi carga?',
    a: 'Ingresá tu número de BL en el buscador de esta página. Verás la información de seguimiento disponible para tu BL.',
  },
  {
    q: '¿La carga tiene seguro incluido?',
    a: 'Todas las cargas viajan con seguro marítimo básico. Ofrecemos adicional a todo riesgo según valor declarado.',
  },
  {
    q: '¿Hacen la distribución final dentro de la isla?',
    a: 'Sí. Bodega propia de 800m² en Hanga Roa y vehículos para distribución local a cualquier punto de la isla.',
  },
];
---

<section id="faq" class="relative py-24 md:py-32 border-t border-white/5">
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    <div class="reveal text-center mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-4">Preguntas frecuentes</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight">
        <span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#fff,#94a3b8)">Resolvemos tus dudas</span>
      </h2>
    </div>
    <div class="reveal space-y-3">
      {faqs.map(({ q, a }) => (
        <div class="faq-item rounded-xl border border-white/10 cursor-pointer hover:border-white/20 transition-colors" style="background:rgba(255,255,255,0.02)">
          <div class="flex items-center justify-between p-5">
            <span class="text-sm font-semibold text-white pr-4">{q}</span>
            <Icon name="chevron-down" width={18} height={18} class="faq-chevron text-slate-500 flex-shrink-0" />
          </div>
          <div class="faq-answer px-5">
            <p class="text-sm text-slate-400 leading-relaxed">{a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import Icon from '../ui/Icon.astro';
---

<section id="rutas" class="relative py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="reveal text-center max-w-3xl mx-auto mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-4">Cobertura de rutas</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-4"><span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#fff,#94a3b8)">Desde los principales puertos de Chile</span></h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="reveal group rounded-2xl p-6 border border-white/10 hover:border-cyan-500/30 transition-all duration-300" style="background:rgba(255,255,255,0.02)">
        <div class="h-48 rounded-xl overflow-hidden mb-6"><img src="https://picsum.photos/seed/valparaiso-port-chile/600/400.jpg" alt="Valparaíso" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-70" /></div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 bg-cyan-400 rounded-full"></span>
          <span class="text-sm font-semibold text-white">Valparaíso</span>
          <span class="ml-auto text-[10px] font-bold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-full">Principal</span>
        </div>
        <p class="text-sm text-slate-400 mb-4">Mayor frecuencia de salidas, capacidad para contenedores 20' y 40'.</p>
        <div class="flex items-center gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1"><Icon name="calendar" width={12} height={12} /> 2 salidas/semana</span>
          <span class="flex items-center gap-1"><Icon name="timer" width={12} height={12} /> 4 días</span>
        </div>
      </div>
      <div class="reveal group rounded-2xl p-6 border border-white/10 hover:border-cyan-500/30 transition-all duration-300" style="background:rgba(255,255,255,0.02)">
        <div class="h-48 rounded-xl overflow-hidden mb-6"><img src="https://picsum.photos/seed/san-antonio-port/600/400.jpg" alt="San Antonio" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-70" /></div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 bg-cyan-400 rounded-full"></span>
          <span class="text-sm font-semibold text-white">San Antonio</span>
        </div>
        <p class="text-sm text-slate-400 mb-4">Terminal multipropósito. Ideal para alto volumen y project cargo.</p>
        <div class="flex items-center gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1"><Icon name="calendar" width={12} height={12} /> 1 salida/semana</span>
          <span class="flex items-center gap-1"><Icon name="timer" width={12} height={12} /> 4.5 días</span>
        </div>
      </div>
      <div class="reveal group rounded-2xl p-6 border border-teal-500/30 transition-all duration-300" style="background:rgba(255,255,255,0.02)">
        <div class="h-48 rounded-xl overflow-hidden mb-6"><img src="https://picsum.photos/seed/easter-island-moai/600/400.jpg" alt="Rapa Nui" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-70" /></div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 bg-orange-400 rounded-full"></span>
          <span class="text-sm font-semibold text-white">Hanga Roa — Rapa Nui</span>
          <span class="ml-auto text-[10px] font-bold uppercase tracking-wider text-orange-400 bg-orange-500/10 px-2 py-0.5 rounded-full">Destino</span>
        </div>
        <p class="text-sm text-slate-400 mb-4">Descarga, traslado terrestre y entrega en bodega.</p>
        <div class="flex items-center gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1"><Icon name="warehouse" width={12} height={12} /> Bodega propia</span>
          <span class="flex items-center gap-1"><Icon name="truck" width={12} height={12} /> Última milla</span>
        </div>
      </div>
    </div>
    <!-- Route Visual -->
    <div class="reveal relative rounded-2xl p-8 md:p-12 border border-white/10 overflow-hidden" style="background:rgba(255,255,255,0.02)">
      <div class="absolute inset-0 bg-grid-pattern opacity-50"></div>
      <div class="relative z-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="text-center md:text-left">
            <div class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-2">Distancia marítima</div>
            <div class="text-4xl md:text-5xl font-bold text-white mb-1">3,700 <span class="text-lg text-slate-500 font-normal">km</span></div>
          </div>
          <div class="flex-1 max-w-md w-full">
            <div class="relative h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.05)">
              <div class="absolute left-0 top-0 h-full rounded-full" style="width:100%;background:linear-gradient(to right,#22d3ee,#0e7490);opacity:0.3"></div>
              <div class="absolute left-0 top-0 h-full rounded-full" style="width:70%;background:linear-gradient(to right,#22d3ee,#0e7490)"></div>
              <div class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-cyan-400 rounded-full" style="left:70%;box-shadow:0 0 12px rgba(34,211,238,0.8)">
                <div class="absolute inset-0 bg-cyan-400 rounded-full pulse-ring"></div>
              </div>
            </div>
            <div class="flex justify-between mt-3 text-xs text-slate-500">
              <span>Valparaíso</span><span class="text-cyan-400 font-medium">En tránsito</span><span>Hanga Roa</span>
            </div>
          </div>
          <div class="text-center md:text-right">
            <div class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-2">Próxima salida</div>
            <div class="text-4xl md:text-5xl font-bold text-white mb-1" id="countdown">72h</div>
            <p class="text-sm text-slate-400">Martes 06:00 hrs</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import Icon from '../ui/Icon.astro';
---

<section class="relative min-h-screen flex items-center overflow-hidden" style="padding-top:130px">
  <div class="hero-bg">
    <img src="https://picsum.photos/id/1057/1920/1080.jpg" alt="Atardecer océano Pacífico" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 hero-overlay-left"></div>
    <div class="absolute inset-0 hero-overlay-bottom"></div>
    <div class="absolute inset-0 hero-warm-glow"></div>
  </div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-0 pointer-events-none">
    <div class="glow-beam h-px mx-auto" style="background:linear-gradient(to right,transparent,#22d3ee,transparent);filter:blur(4px);width:600px"></div>
    <div class="glow-beam h-8 mx-auto -mt-4 opacity-20" style="background:linear-gradient(to right,transparent,#22d3ee,transparent);filter:blur(24px);width:600px"></div>
  </div>
  <div class="absolute bottom-20 left-0 right-0 z-0 pointer-events-none overflow-hidden">
    <div class="ship-sail text-cyan-400/20">
      <Icon name="ship" width={60} height={60} />
    </div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 pb-32 md:pb-48 w-full">
    <div class="grid lg:grid-cols-5 gap-12 items-start">
      <div class="lg:col-span-3">
        <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full mb-8" style="background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.2);backdrop-filter:blur(4px)">
          <span class="w-2 h-2 bg-orange-400 rounded-full animate-pulse"></span>
          <span class="text-xs font-semibold uppercase tracking-wide text-orange-200">Ruta activa — Salida semanal desde Valparaíso</span>
        </div>
        <h1 class="reveal text-5xl md:text-7xl font-extrabold leading-[1.05] tracking-tight mb-8">
          <span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#fff 0%,#94a3b8 100%)">Cargo marítimo</span><br/>
          <span class="text-cyan-400">Chile → Rapa Nui</span>
        </h1>
        <p class="reveal text-lg md:text-xl text-slate-400 leading-relaxed max-w-2xl mb-10">
          Transportamos pallets, contenedores y carga comercial a granel desde los principales puertos de Chile hasta Isla de Pascua. <strong class="text-slate-300">Flota propia, frecuencia semanal, logística integral.</strong>
        </p>
        <div class="reveal flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#contacto" class="cta-btn inline-flex items-center justify-center gap-2 text-base font-semibold text-white px-8 py-4 rounded-full transition-all duration-300 hover:-translate-y-1" style="background:linear-gradient(to right,#0c2d48,#134e4a);box-shadow:0 0 40px -10px rgba(34,211,238,0.3)">
            Solicitar Cotización <Icon name="arrow-right" width={18} height={18} />
          </a>
          <a href="#tracker" class="inline-flex items-center justify-center gap-2 text-base font-semibold text-slate-300 px-8 py-4 rounded-full border border-white/10 hover:bg-white/5 hover:border-white/20 transition-all duration-300">
            <Icon name="radar" width={18} height={18} />
            Rastrear Carga
          </a>
        </div>
      </div>
      <div class="lg:col-span-2 reveal">
        <div class="rounded-2xl p-6 border border-white/10" style="background:rgba(5,5,5,0.75);backdrop-filter:blur(24px)">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-cyan-500/10">
              <Icon name="calculator" width={16} height={16} class="text-cyan-400" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Cotización Rápida</h3>
              <p class="text-[10px] text-slate-500">Precio estimado se envía a tu correo</p>
            </div>
          </div>
          <form id="quickQuoteForm" class="space-y-3">
            <select name="origen" required aria-label="Puerto de origen" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors appearance-none cursor-pointer" style="background:rgba(255,255,255,0.03)">
              <option value="" class="bg-slate-900">Origen</option>
              <option value="Valparaíso" class="bg-slate-900">Valparaíso</option>
              <option value="San Antonio" class="bg-slate-900">San Antonio</option>
              <option value="Arica" class="bg-slate-900">Arica</option>
            </select>
            <select name="tipo_carga" required aria-label="Tipo de carga" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors appearance-none cursor-pointer" style="background:rgba(255,255,255,0.03)">
              <option value="" class="bg-slate-900">Tipo de carga</option>
              <option value="Pallets" class="bg-slate-900">Pallets</option>
              <option value="Contenedor FCL" class="bg-slate-900">Contenedor FCL</option>
              <option value="Carga fraccionada LCL" class="bg-slate-900">Carga fraccionada LCL</option>
              <option value="Vehículo / Maquinaria" class="bg-slate-900">Vehículo / Maquinaria</option>
            </select>
            <div class="grid grid-cols-2 gap-3">
              <input name="cantidad" type="number" placeholder="Cantidad" min="1" required aria-label="Cantidad" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white placeholder-slate-600 border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors" style="background:rgba(255,255,255,0.03)" />
              <input name="peso" type="text" placeholder="Peso (kg)" required aria-label="Peso en kilogramos" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white placeholder-slate-600 border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors" style="background:rgba(255,255,255,0.03)" />
            </div>
            <input name="email" type="email" placeholder="Tu correo electrónico" required aria-label="Correo electrónico" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white placeholder-slate-600 border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors" style="background:rgba(255,255,255,0.03)" />
            <input name="nombre" type="text" placeholder="Nombre y teléfono" required aria-label="Nombre y teléfono" class="w-full px-3.5 py-2.5 rounded-lg text-sm text-white placeholder-slate-600 border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors" style="background:rgba(255,255,255,0.03)" />
            <button type="submit" class="cta-btn-sq w-full flex items-center justify-center gap-2 text-sm font-bold text-white py-3 rounded-xl transition-all duration-300 hover:-translate-y-0.5" style="background:linear-gradient(to right,#0c2d48,#134e4a);box-shadow:0 0 30px -10px rgba(34,211,238,0.3)">
              Enviar Cotización a mi Correo <Icon name="mail" width={14} height={14} />
            </button>
          </form>
          <div id="quickFormSuccess" class="hidden text-center py-2 px-3 rounded-lg text-xs font-medium text-teal-400 border border-teal-500/20 mt-2" style="background:rgba(20,184,166,0.1)">
            <Icon name="check-circle" width={14} height={14} class="inline-block mr-1" />
            ¡Listo! Abrimos tu cliente de correo con la solicitud lista para enviar. Respondemos en menos de 2 horas.
          </div>
        </div>
      </div>
    </div>
    <div class="reveal flex flex-wrap items-center gap-6 md:gap-10 mt-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(34,211,238,0.1)">
          <Icon name="box" width={20} height={20} class="text-cyan-400" />
        </div>
        <div><div class="text-lg font-bold text-white">+12,000</div><div class="text-[11px] text-slate-500 uppercase tracking-wide">Pallets/año</div></div>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(34,211,238,0.1)">
          <Icon name="ship" width={20} height={20} class="text-cyan-400" />
        </div>
        <div><div class="text-lg font-bold text-white">8</div><div class="text-[11px] text-slate-500 uppercase tracking-wide">Buques activos</div></div>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(34,211,238,0.1)">
          <Icon name="clock" width={20} height={20} class="text-cyan-400" />
        </div>
        <div><div class="text-lg font-bold text-white">4-5 días</div><div class="text-[11px] text-slate-500 uppercase tracking-wide">Tiempo tránsito</div></div>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:rgba(20,184,166,0.1)">
          <Icon name="check-circle-2" width={20} height={20} class="text-teal-400" />
        </div>
        <div><div class="text-lg font-bold text-white">99.2%</div><div class="text-[11px] text-slate-500 uppercase tracking-wide">Cumplimiento</div></div>
      </div>
    </div>
  </div>
</section>

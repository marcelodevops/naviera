---
import Icon from '../ui/Icon.astro';
---

<section id="tracker" class="relative py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="reveal text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-4">Seguimiento interactivo</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-4">
        <span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#fff,#94a3b8)">Rastreá tu carga</span>
      </h2>
      <p class="text-lg text-slate-400">Ingresá tu número de BL para consultar el estado registrado. Precios enviados solo por correo.</p>
    </div>

    <div class="reveal flex justify-center gap-2 mb-10">
      <button class="tab-btn active text-sm font-semibold px-6 py-2.5 rounded-full border border-white/10 transition-all cursor-pointer" data-tab="rastrear">
        <Icon name="radar" width={15} height={15} class="inline-block mr-1.5 -mt-0.5" />Rastrear Carga
      </button>
      <button class="tab-btn text-sm font-semibold px-6 py-2.5 rounded-full border border-white/10 text-slate-500 transition-all cursor-pointer" data-tab="estimar">
        <Icon name="timer" width={15} height={15} class="inline-block mr-1.5 -mt-0.5" />Estimador de Tiempos
      </button>
    </div>

    <!-- TAB: RASTREAR -->
    <div id="tab-rastrear" class="tab-panel active">
      <div class="max-w-2xl mx-auto mb-10">
        <div class="relative">
          <Icon name="search" width={20} height={20} class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500" />
          <input type="text" id="trackerInput" placeholder="Ej: TAINA-2025-0047" class="tracker-input-lg w-full pl-12 pr-36 py-4 rounded-2xl text-base text-white placeholder-slate-600 border border-white/10 focus:outline-none transition-all" style="background:rgba(255,255,255,0.03)" />
          <button id="trackerBtn" class="absolute right-2 top-1/2 -translate-y-1/2 cta-btn-sq text-sm font-bold text-white px-6 py-2.5 rounded-xl transition-all hover:-translate-y-0.5 cursor-pointer" style="background:linear-gradient(to right,#0c2d48,#134e4a);box-shadow:0 0 30px -10px rgba(34,211,238,0.3)">Rastrear</button>
        </div>
        <p id="trackingDemoExamples" class="text-center text-xs text-slate-600 mt-3">Referencias de demostración: <button type="button" data-demo-tracking="TAINA-2025-0047" class="text-cyan-400/60 cursor-pointer hover:text-cyan-400">TAINA-2025-0047</button> · <button type="button" data-demo-tracking="TAINA-2025-0051" class="text-cyan-400/60 cursor-pointer hover:text-cyan-400">TAINA-2025-0051</button> · <button type="button" data-demo-tracking="TAINA-2025-0042" class="text-cyan-400/60 cursor-pointer hover:text-cyan-400">TAINA-2025-0042</button> · <button type="button" data-demo-tracking="TAINA-2025-0055" class="text-cyan-400/60 cursor-pointer hover:text-cyan-400">TAINA-2025-0055</button></p>
        <p id="trackingModeNotice" class="text-center text-xs text-amber-400/70 mt-2">Datos de demostración; no corresponden a embarques reales.</p>
      </div>
      <div id="trackerResults" class="max-w-4xl mx-auto"></div>
    </div>

    <!-- TAB: ESTIMAR -->
    <div id="tab-estimar" class="tab-panel">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-2" for="estOrigin">Puerto de origen</label>
            <select id="estOrigin" class="w-full px-4 py-3 rounded-xl text-sm text-white border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors appearance-none cursor-pointer" style="background:rgba(255,255,255,0.03)">
              <option value="valp" class="bg-slate-900">Valparaíso</option>
              <option value="sa" class="bg-slate-900">San Antonio</option>
              <option value="arica" class="bg-slate-900">Arica</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-2" for="estType">Tipo de carga</label>
            <select id="estType" class="w-full px-4 py-3 rounded-xl text-sm text-white border border-white/10 focus:border-cyan-500/50 focus:outline-none transition-colors appearance-none cursor-pointer" style="background:rgba(255,255,255,0.03)">
              <option value="pallets" class="bg-slate-900">Pallets</option>
              <option value="fcl" class="bg-slate-900">Contenedor FCL</option>
              <option value="lcl" class="bg-slate-900">Carga fraccionada LCL</option>
              <option value="vehiculo" class="bg-slate-900">Vehículo / Maquinaria</option>
            </select>
          </div>
          <div class="flex items-end">
            <button id="estBtn" class="cta-btn-sq w-full flex items-center justify-center gap-2 text-sm font-bold text-white py-3 rounded-xl transition-all hover:-translate-y-0.5 cursor-pointer" style="background:linear-gradient(to right,#0c2d48,#134e4a);box-shadow:0 0 30px -10px rgba(34,211,238,0.3)">
              <Icon name="clock" width={16} height={16} /> Calcular Tiempos
            </button>
          </div>
        </div>
        <div id="estResults"></div>
      </div>
    </div>
  </div>
</section>

---
import Icon from '../ui/Icon.astro';

const companies = [
  'Distribuidora Mendoza',
  'Constructora Atacama',
  'Hotel Mana Nui',
  'Ferretería del Pacífico',
  'Supermercado Tuku Henua',
  'Minera Pacífico Sur',
  'Distribuidora Rapa Nui',
  'Aguas Rapa Nui S.A.',
];
---

<section id="clientes" class="relative py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="reveal text-center max-w-3xl mx-auto mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-400 mb-4">Clientes que confían en nosotros</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight"><span class="bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#fff,#94a3b8)">Quienes mueven carga con TAINA</span></h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="reveal rounded-2xl p-6 md:p-8 border border-white/10 hover:border-cyan-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
        <div class="flex gap-1 mb-4">
          {Array.from({ length: 5 }).map(() => (
            <Icon name="star" width={16} height={16} class="text-orange-400" />
          ))}
        </div>
        <p class="text-sm text-slate-300 leading-relaxed mb-6">"Enviamos 40 pallets mensuales. TAINA nunca nos falla. El seguimiento online es excelente."</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-sm font-semibold text-cyan-400">RM</div>
          <div>
            <div class="text-sm font-semibold text-white">Roberto Mendoza</div>
            <div class="text-xs text-slate-500">Distribuidora Mendoza</div>
          </div>
        </div>
      </div>
      <div class="reveal rounded-2xl p-6 md:p-8 border border-white/10 hover:border-cyan-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
        <div class="flex gap-1 mb-4">
          {Array.from({ length: 5 }).map(() => (
            <Icon name="star" width={16} height={16} class="text-orange-400" />
          ))}
        </div>
        <p class="text-sm text-slate-300 leading-relaxed mb-6">"Materiales de construcción para 3 proyectos en la isla. La logística de pallets pesados es impecable."</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-sm font-semibold text-cyan-400">CL</div>
          <div>
            <div class="text-sm font-semibold text-white">Carolina López</div>
            <div class="text-xs text-slate-500">Constructora Atacama S.A.</div>
          </div>
        </div>
      </div>
      <div class="reveal rounded-2xl p-6 md:p-8 border border-teal-500/30 transition-all" style="background:rgba(255,255,255,0.02)">
        <div class="flex gap-1 mb-4">
          {Array.from({ length: 5 }).map(() => (
            <Icon name="star" width={16} height={16} class="text-orange-400" />
          ))}
        </div>
        <p class="text-sm text-slate-300 leading-relaxed mb-6">"Como hotel en Rapa Nui dependemos de suministro constante. El rastreo en tiempo real resuelve todo."</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-sm font-semibold text-teal-400">PT</div>
          <div>
            <div class="text-sm font-semibold text-white">Patricio Tuki</div>
            <div class="text-xs text-slate-500">Hotel Mana Nui — Rapa Nui</div>
          </div>
        </div>
      </div>
    </div>
    <div class="reveal mt-16 pt-12 border-t border-white/5 overflow-hidden">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-600 mb-8">Empresas que transportan con nosotros</p>
      <div class="relative overflow-hidden">
        <div class="marquee-track flex items-center gap-16 whitespace-nowrap" style="width: max-content;">
          {[...companies, ...companies].map((company) => (
            <div class="flex items-center gap-2 text-slate-500">
              <Icon name="building-2" width={20} height={20} />
              <span class="text-sm font-medium">{company}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

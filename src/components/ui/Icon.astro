---
import * as lucideIcons from 'lucide';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
  [key: string]: any;
}

const {
  name: rawName,
  class: className = '',
  size = 24,
  width = size,
  height = size,
  ...rest
} = Astro.props;

const cleanName = rawName.replace(/^lucide:/, '');

const brandIcons: Record<string, [string, Record<string, string>][]> = {
  facebook: [
    ['path', { d: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' }],
  ],
  instagram: [
    ['rect', { width: '20', height: '20', x: '2', y: '2', rx: '5', ry: '5' }],
    ['path', { d: 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z' }],
    ['line', { x1: '17.5', x2: '17.51', y1: '6.5', y2: '6.5' }],
  ],
  linkedin: [
    ['path', { d: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z' }],
    ['rect', { width: '4', height: '12', x: '2', y: '9' }],
    ['circle', { cx: '4', cy: '4', r: '2' }],
  ],
};

const toPascal = (str: string) => str.replace(/(^|-)([a-z0-9])/g, (_, __, c) => c.toUpperCase());
const pascalName = toPascal(cleanName);

const iconNodes = brandIcons[cleanName.toLowerCase()] ?? (lucideIcons as any)[pascalName] ?? [];
---

{iconNodes.length > 0 && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={width}
    height={height}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    {...rest}
  >
    {iconNodes.map(([tag, attrs]: [string, Record<string, string>]) => {
      if (tag === 'path') return <path {...attrs} />;
      if (tag === 'circle') return <circle {...attrs} />;
      if (tag === 'rect') return <rect {...attrs} />;
      if (tag === 'line') return <line {...attrs} />;
      if (tag === 'polyline') return <polyline {...attrs} />;
      if (tag === 'polygon') return <polygon {...attrs} />;
      return null;
    })}
  </svg>
)}
